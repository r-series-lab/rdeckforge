{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "app.rseries.rdeckforge.content.teaching_deck_v1",
  "title": "rDeckForge Teaching Deck Content",
  "type": "object",
  "anyOf": [
    { "required": ["schemaVersion", "documentType", "title", "chapters"] },
    { "required": ["schemaVersion", "documentType", "pages"] }
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "documentType": { "type": "string", "enum": ["teaching_deck", "pptx_pages"] },
    "title": { "type": "string", "minLength": 1 },
    "speaker": { "type": "string" },
    "date": { "type": "string" },
    "goals": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "title", "items"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "contentTitle": { "type": "string" },
          "items": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["heading", "body"],
              "properties": {
                "heading": { "type": "string" },
                "body": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "evaluations": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["title", "items"],
        "properties": {
          "title": { "type": "string" },
          "items": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string" }
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["use", "data"],
        "properties": {
          "use": { "type": "string", "minLength": 1 },
          "pageTemplate": { "type": "string", "minLength": 1 },
          "data": { "type": "object" }
        }
      }
    }
  }
}
