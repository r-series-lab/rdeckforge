{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "app.rseries.rdeckforge.template_manifest.v1",
  "title": "rDeckForge Template Manifest",
  "type": "object",
  "required": ["schemaVersion", "templateId", "name", "format"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "templateId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "format": { "type": "string", "enum": ["pptx", "docx", "xlsx"] },
    "templateType": { "type": "string", "enum": ["declarative", "script", "hybrid"] },
    "entry": { "type": "string", "minLength": 1 },
    "contentSchema": { "type": "string" },
    "renderMode": { "type": "string" },
    "renderer": { "$ref": "#/$defs/renderer" },
    "pipeline": {
      "type": "array",
      "items": { "$ref": "#/$defs/pipelineStep" }
    },
    "dependencies": { "$ref": "#/$defs/templateDependencies" },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/templateTestCase" }
    },
    "input": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["teaching_deck_v1", "design_doc_v1", "feature_assessment_v1"]
        },
        "formats": {
          "type": "array",
          "items": { "type": "string", "enum": ["json", "md", "markdown"] }
        },
        "schema": { "type": "string" },
        "schemaId": { "type": "string" },
        "mdProfile": {
          "type": "string",
          "enum": ["teaching_outline_v1", "design_doc_v1"]
        },
        "authoring": { "$ref": "#/$defs/templateAuthoring" }
      },
      "additionalProperties": true
    },
    "preview": { "$ref": "#/$defs/templatePreview" },
    "pageTemplates": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/pageTemplate" }
    },
    "deckRecipes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/recipeStep" }
      }
    },
    "blockTemplates": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/blockTemplate" }
    },
    "documentRecipes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/recipeStep" }
      }
    },
    "sheetTemplates": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sheetTemplate" }
    },
    "workbookRecipes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/recipeStep" }
      }
    },
    "layouts": { "type": "object" }
  },
  "additionalProperties": true,
  "$defs": {
    "templateAuthoring": {
      "type": "object",
      "properties": {
        "instructions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "examples": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "templatePreview": {
      "type": "object",
      "properties": {
        "cover": { "type": "string", "minLength": 1 },
        "slides": {
          "type": "array",
          "items": { "$ref": "#/$defs/templatePreviewSlide" }
        }
      },
      "additionalProperties": true
    },
    "templatePreviewSlide": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "title": { "type": "string" },
        "image": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "renderer": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string" },
        "entry": { "type": "string" },
        "input": { "type": "string" },
        "output": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "pipelineStep": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string" },
        "entry": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "templateDependencies": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileDependency" }
        },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/commandDependency" }
        },
        "environment": {
          "type": "array",
          "items": { "$ref": "#/$defs/environmentDependency" }
        }
      },
      "additionalProperties": false
    },
    "fileDependency": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["python_requirements", "node_package", "config", "resource", "other"]
        },
        "required": { "type": "boolean" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "commandDependency": {
      "type": "object",
      "required": ["id", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "required": { "type": "boolean" },
        "platforms": {
          "type": "array",
          "items": { "type": "string", "enum": ["macos", "windows", "linux"] }
        },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "environmentDependency": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "allowEmpty": { "type": "boolean" },
        "platforms": {
          "type": "array",
          "items": { "type": "string", "enum": ["macos", "windows", "linux"] }
        },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "templateTestCase": {
      "type": "object",
      "required": ["id", "input"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "input": { "type": "string", "minLength": 1 },
        "recipe": { "type": "string", "minLength": 1 },
        "outputName": { "type": "string", "minLength": 1 },
        "assertions": { "$ref": "#/$defs/templateTestAssertions" }
      },
      "additionalProperties": false
    },
    "templateTestAssertions": {
      "type": "object",
      "properties": {
        "validatePackage": { "type": "boolean" },
        "minSizeBytes": { "type": "integer", "minimum": 0 },
        "minSlides": { "type": "integer", "minimum": 0 },
        "maxSlides": { "type": "integer", "minimum": 0 },
        "minSheets": { "type": "integer", "minimum": 0 },
        "maxSheets": { "type": "integer", "minimum": 0 },
        "requiredZipEntries": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredText": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "forbiddenText": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "additionalProperties": false
    },
    "pageTemplate": {
      "type": "object",
      "required": ["sourceSlide"],
      "properties": {
        "sourceSlide": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "bindings": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/pageBinding" }
        },
        "constraints": { "type": "object" }
      },
      "additionalProperties": true
    },
    "pageBinding": {
      "type": "object",
      "properties": {
        "shapeName": { "type": "string" },
        "creationId": { "type": "string" },
        "dataPath": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["text", "list", "image", "backgroundImage", "table", "chart", "repeat"]
        },
        "required": { "type": "boolean" },
        "maxLength": { "type": "integer", "minimum": 1 },
        "maxItems": { "type": "integer", "minimum": 1 },
        "fit": { "type": "string" },
        "chartMode": { "type": "string", "enum": ["image", "native"] }
      },
      "additionalProperties": true
    },
    "blockTemplate": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "bindings": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/documentBinding" }
        },
        "constraints": { "type": "object" }
      },
      "additionalProperties": true
    },
    "documentBinding": {
      "type": "object",
      "properties": {
        "placeholder": { "type": "string" },
        "bookmark": { "type": "string" },
        "contentControl": { "type": "string" },
        "dataPath": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "list", "table", "image", "documentBlocks"] },
        "required": { "type": "boolean" },
        "maxLength": { "type": "integer", "minimum": 1 },
        "maxItems": { "type": "integer", "minimum": 1 },
        "widthInches": { "type": "number", "exclusiveMinimum": 0 },
        "heightInches": { "type": "number", "exclusiveMinimum": 0 },
        "blockStyles": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "sheetTemplate": {
      "type": "object",
      "properties": {
        "sourceSheet": { "type": "string" },
        "sourceSheetIndex": { "type": "integer", "minimum": 1 },
        "outputSheetName": { "type": "string" },
        "bindings": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sheetBinding" }
        },
        "constraints": { "type": "object" }
      },
      "additionalProperties": true
    },
    "sheetBinding": {
      "type": "object",
      "properties": {
        "cell": { "type": "string" },
        "namedRange": { "type": "string" },
        "dataPath": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "list", "table"] },
        "required": { "type": "boolean" },
        "maxLength": { "type": "integer", "minimum": 1 },
        "maxItems": { "type": "integer", "minimum": 1 },
        "tableColumns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "header": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "tableBodyRowOffset": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "recipeStep": {
      "type": "object",
      "required": ["use"],
      "properties": {
        "use": { "type": "string", "minLength": 1 },
        "data": { "type": "string" },
        "repeat": { "type": "string" },
        "chunk": { "$ref": "#/$defs/repeatChunk" },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/recipeStepVariant" }
        },
        "overflow": { "$ref": "#/$defs/recipeStepOverflow" },
        "when": { "type": "string" }
      },
      "additionalProperties": true
    },
    "recipeStepVariant": {
      "type": "object",
      "required": ["use"],
      "properties": {
        "use": { "type": "string", "minLength": 1 },
        "when": { "$ref": "#/$defs/variantCondition" }
      },
      "additionalProperties": true
    },
    "variantCondition": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "countMin": { "type": "integer", "minimum": 0 },
        "countMax": { "type": "integer", "minimum": 0 },
        "countEq": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "recipeStepOverflow": {
      "type": "object",
      "required": ["path", "maxItems"],
      "properties": {
        "strategy": { "type": "string", "enum": ["split"] },
        "path": { "type": "string", "minLength": 1 },
        "maxItems": { "type": "integer", "minimum": 1 },
        "as": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "repeatChunk": {
      "type": "object",
      "required": ["size"],
      "properties": {
        "size": { "type": "integer", "minimum": 1 },
        "as": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
