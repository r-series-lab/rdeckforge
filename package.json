{
  "name": "rdeckforge",
  "private": true,
  "version": "0.1.5",
  "scripts": {
    "dev": "cd src-tauri && npm --prefix ../web exec tauri -- dev --config tauri.conf.json",
    "prebuild": "npm run clean:build-cache",
    "build": "node scripts/build-release.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:build": "node scripts/build-distribution.mjs",
    "cli": "cargo run --quiet --",
    "cli:json": "cargo run --quiet -- --json",
    "cli:build": "node scripts/build-cli-sidecar.mjs --profile release",
    "cli:build:dev": "node scripts/build-cli-sidecar.mjs --profile debug",
    "cli:install": "node scripts/install-cli.mjs",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "pptx:build": "npm --prefix renderers/pptx-node run build",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "smoke:macos-ui": "node scripts/smoke-macos-ui.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "rust-check": "cargo check --manifest-path ./src-tauri/Cargo.toml",
    "size": "node scripts/size.mjs",
    "clean:build-cache": "node scripts/clean.mjs build-cache",
    "clean": "node scripts/clean.mjs normal",
    "clean:all": "node scripts/clean.mjs all"
  }
}
